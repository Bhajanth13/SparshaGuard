flowchart LR
  %% SparshaGuard project map, left to right: sources -> physics -> checks -> study -> demo

  subgraph S1["① Sources"]
    direction TB
    PAP["15 published papers<br/>Touché · Jonassen · Goyal<br/>Datta · Nath · TI · …"]
    PAR[("parameter_sources.md<br/>paper_values.xlsx")]
    PAP --> PAR
  end

  subgraph S2["② Physics · sg_model.py"]
    direction TB
    CIR["Circuit: 200-freq sweep<br/>LC tank · skin CPE<br/>C = ε₀εᵣA/d"]
    SOL["4-node solve<br/>[Y]·V = I<br/>floating watch ground"]
    SCO["Change score<br/>RMS |V| − |V_base|"]
    BEM["3D field (fem/)<br/>hand near strap<br/>1.4 → 0.05 pF"]
    CIR --> SOL --> SCO
    BEM --> CIR
  end

  subgraph S3["③ Checks"]
    direction TB
    SPI["SPICE (ngspice)<br/>49 cases, Δ < 0.0001 %"]
    FCP["FastCap (MIT)<br/>within 1 %"]
  end

  subgraph S4["④ Study (Python)"]
    direction TB
    DAT["Dataset<br/>18,000 events"]
    ML["Classifiers<br/>SVM · forest"]
    LIFE["Daily-life sim<br/>2 s hold rule"]
    RES[("Results<br/>wrist 16 % signal<br/>93 % caught<br/>forearm/shoulder 0 %")]
    DAT --> ML --> LIFE --> RES
  end

  subgraph S5["⑤ Demo (browser)"]
    direction TB
    SEN["Sensor twin<br/>model + drift + noise"]
    FW["Watch firmware<br/>threshold · PIN · duress"]
    UI["Demo page<br/>watch · phone · story"]
    SEN --> FW --> UI
  end

  subgraph S6["⑥ User flow"]
    direction TB
    U1["Touch held 2 s"] --> U2["PIN, 15 s"]
    U2 -- "1234" --> U3["Cancelled"]
    U2 -- "none / wrong" --> U4["SMS + GPS<br/>call 112"]
    U2 -- "9999" --> U5["Silent alert"]
  end

  PAR --> CIR
  SOL -.-> SPI
  BEM -.-> FCP
  SCO --> DAT
  SCO == "ported to JS" ==> SEN
  LIFE == "same rules" ==> FW
  UI --> U1
  RES -. "Gate 1 prototype<br/>calibrates" .-> PAR
